{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ChatNode.Infrastructure.AI": "Debug"
    }
  },
  "ConnectionStrings": {
    "Valkey": "localhost:6379",
    "AnonimyzeService": "http://localhost:50051",
    "Postgres": "Host=localhost;Port=5432;Database=grants;Username=grants;Password=grants"
  },
  "ExpirationPolicy": {
    "UserExpirationSeconds": 86400,
    "ChatExpirationSeconds": 86400,
    "MessageStreamExpirationSeconds": 86400,
    "PinExpirationSeconds": 86400
  },
  "CachePolicy": {
    "ManualPartsSeconds": 86400
  },
  "ManualUpload": {
    "MaxFileSizeBytes": 262144,
    "StaffMaxFileSizeBytes": 10485760
  },
  "WebSocket": {
    "TicketExpirationInSeconds": 30
  },
  "StaffAccounts": {
    "Accounts": [
      {
        "Id": "8ef25a1d-6581-4167-80d0-e83296ff323c",
        "Login": "prorektor",
        "Password": "prorektor",
        "Name": "Проректор",
        "Email": "prorektor@example.ru",
        "Role": "Rector"
      },
      {
        "Id": "3c1de0d6-0a3f-4a2e-9f2b-1f0f5a7c9d21",
        "Login": "koordinator",
        "Password": "koordinator",
        "Name": "Координатор",
        "Email": "koordinator@example.ru",
        "Role": "Coordinator"
      }
    ]
  },
  "Jwt": {
    "SecretKey": "YOUR_SUPER_SECRET_KEY_32_CHARS_LONG",
    "Issuer": "ChatNode",
    "Audience": "ChatNodeClients",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 1
  },
  "S3": {
    "ServiceUrl": "http://localhost:8333",
    "AccessKey": "any",
    "SecretKey": "any",
    "BucketName": "grants",
    "ForcePathStyle": true,
    "UseHttp": true
  },
  "GigaChat": {
    "AuthUrl": "https://ngw.devices.sberbank.ru:9443/api/v2/oauth",
    "BaseUrl": "https://api.giga.chat/v1",
    "ManualParserAgentModel": "GigaChat-2-Max",
    "ConsultingAgentModel": "GigaChat-2-Pro",
    "ApplicationReviewAgentModel": "GigaChat-2-Max",
    "ApplicationSectionChars": 4000,
    "ApplicationSectionToolCalls": 12,
    "PinDuplicateDistance": 0.15,
    "PinSearchDistance": 0.55,
    "EmbeddingModel": "Embeddings",
    "EmbeddingDim": 1024, 
    "Scope": "GIGACHAT_API_B2B",
    "TimeoutMinutes": 10,
    "MaxRetries": 4,
    "RetryBackoffFactor": 1.0,
    "RetryOnStatusCodes": [ 408, 429, 500, 502, 503, 504 ],
    "TransportRetries": 3,
    "MaxOperationAttempts": 2,
    "OperationRetryDelaySeconds": 5
  }
}
